# Copy to .env (git-ignored) and fill in real values. Every variable the app reads
# must be listed here with a fake value.

# --- Postgres ---
POSTGRES_USER=cinematch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cinematch
# Host port for the db container. 5433 avoids clashing with a local Postgres on 5432.
POSTGRES_HOST_PORT=5433
# Inside Docker the host is "db" (port 5432); from your machine use 127.0.0.1:5433
# (not localhost: on Windows it tries IPv6 first and hangs until a timeout).
DATABASE_URL=postgresql+psycopg://cinematch:change-me@db:5432/cinematch
# Read by pytest on your machine (not from this file: set it in your shell only if
# your Postgres user/password differ from the defaults). Must end in _test.
TEST_DATABASE_URL=postgresql+psycopg://cinematch:change-me@127.0.0.1:5433/cinematch_test

# --- Auth (Phase 6) ---
JWT_SECRET=change-me-to-a-long-random-string

# --- TMDB (Phase 2) ---
TMDB_API_KEY=your-tmdb-v4-read-token

# --- Embeddings (Phase 3) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANK_ENABLED=false

# --- LLM (Phase 10) ---
ANTHROPIC_API_KEY=sk-ant-your-key
LLM_MODEL=claude-haiku-5-5
LLM_ENABLED=true
LLM_DAILY_REQUESTS_PER_USER=20
LLM_GLOBAL_DAILY_BUDGET_USD=1.00
# Set from Anthropic's pricing page (USD per million tokens).
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0

# --- Web ---
CORS_ORIGINS=http://localhost:5173
DOMAIN=localhost
